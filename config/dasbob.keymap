#include <behaviors.dtsi>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// Define custom behaviors for timeless homerow mods (urobs style)
/ {
    behaviors {
        // Timeless homerow mods with quick-tap to still tap when typing fast
        hm: homerow_mods {
            compatible = "zmk,behavior-hold-tap";
            label = "HOMEROW_MODS";
            #binding-cells = <2>;
            tapping-term-ms = <280>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            bindings = <&kp>, <&kp>;
        };

        // Layer tap with quick-tap
        lt_tap: layer_tap_quick {
            compatible = "zmk,behavior-hold-tap";
            label = "LAYER_TAP_QUICK";
            #binding-cells = <2>;
            tapping-term-ms = <200>;
            quick-tap-ms = <150>;
            flavor = "balanced";
            bindings = <&mo>, <&kp>;
        };
    };

    macros {
        // Triple Shift macro (search activation)
        trip_shift: triple_shift {
            compatible = "zmk,behavior-macro";
            #binding-cells = <0>;
            bindings = <&kp LSFT &kp LSFT &kp LSFT>;
            label = "TRIPLE_SHIFT";
        };
    };

    combos {
        compatible = "zmk,combos";
        // Q + W = Tab
        combo_tab {
            timeout-ms = <50>;
            key-positions = <1 2>;
            bindings = <&kp TAB>;
            layers = <0>;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        Base {
            display-name = "Base";
            bindings = <
  &kp Q           &kp W           &kp F           &kp P           &kp B           &kp J           &kp L           &kp U           &kp Y           &kp SEMI
  &kp A           &hm LCTL R      &hm RALT S      &hm LSFT T      &kp G           &kp M           &hm LSFT N      &hm RALT E      &hm LCTL I      &kp O
  &kp Z           &kp X           &kp C           &kp D           &kp V           &kp K           &kp H           &kp COMMA       &kp DOT         &kp SLASH
                                                  &hm LALT ESC    &lt_tap 1 SPACE &hm RALT SQT    &none           &none           &none
            >;
        };

        Num {
            display-name = "Num";
            bindings = <
  &kp N1          &kp N2          &kp N3          &kp N4          &kp N5          &kp N6          &kp N7          &kp N8          &kp N9          &kp N0
  &kp LSFT        &kp LCTL        &kp LGUI        &kp LALT        &kp CAPS        &kp TAB         &kp LEFT        &kp DOWN        &kp UP          &kp RIGHT
  &trans          &trans          &trans          &trans          &kp INS         &none           &kp HOME        &kp PGDN        &kp PGUP        &kp END
                                                  &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };

        Sym {
            display-name = "Sym";
            bindings = <
  &kp EXCL        &kp AT          &kp HASH        &kp DLLR        &kp PRCNT       &kp CARET       &kp AMPS        &kp ASTR        &kp MINUS       &kp EQUAL
  &kp LBKT        &kp RBKT        &kp LPRN        &kp RPRN        &kp GRAVE       &trans          &kp LCBR        &kp RCBR        &kp UNDER       &kp PLUS
  &trans          &trans          &trans          &kp PIPE        &trans          &trans          &kp TILDE       &trans          &trans          &kp BSLH
                                                  &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };

        Fun {
            display-name = "Fun";
            bindings = <
  &kp F1          &kp F2          &kp F3          &kp F4          &kp F5          &kp F6          &kp F7          &kp F8          &kp F9          &kp F10
  &mmv MOVE_LEFT  &mmv MOVE_DOWN  &mmv MOVE_UP    &mmv MOVE_RIGHT &trip_shift     &none           &mkp LCLK       &mkp RCLK       &mkp MCLK       &none
  &msc SCRL_LEFT  &msc SCRL_DOWN  &msc SCRL_UP    &msc SCRL_RIGHT &none           &none           &kp INS         &kp DEL         &none           &none
                                                  &trans          &trans          &trans          &trans          &trans          &trans
            >;
        };
    };
};
